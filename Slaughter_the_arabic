/***************************************************************************
Задача 2: Вырезать подстроку из строки
Напишите программу, которая вырезает подстроку "low" из строки "yellow".
*******************************************************************************/

#include <stdio.h>
#include <string.h>

int main()
{
    char slovo[] = "yellow";
    char result[4];
    int nachalo = 3;
    int end = 6;
    
    int x = 0;
    
    for (int i = nachalo; i < end; i++) {
        result[x] = slovo[i];
        x++;
    }
    
    result[x] ='\0';
    
    printf ("Результат: %s\n", result);
    return 0;
}

